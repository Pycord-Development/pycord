{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Pycord-Development/renovate-config",
    ":semanticPrefixFixDepsChoreOthers",
    ":dependencyDashboard",
    ":enablePreCommit",
    "config:js-lib",
    "group:monorepos",
    "group:allNonMajor"
  ],
  "assigneesFromCodeOwners": true,
  "github-actions": {
    "pinDigests": true
  },
  "lockFileMaintenance": {
    "enabled": true
  }
}
