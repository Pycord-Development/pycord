{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Pycord-Development/renovate-config",
    ":semanticPrefixFixDepsChoreOthers",
    ":dependencyDashboard",
    ":enablePreCommit",
    "group:monorepos",
    "group:allNonMajor"
  ],
  "assigneesFromCodeOwners": true,
  "github-actions": {
    "pinDigests": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "Python Interpreter",
      "description": "Python interpreter upgrades",
      "matchDatasources": [
        "python-version"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
